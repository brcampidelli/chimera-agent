{
  "_about": "S30-28 corpus, fixed 2026-10-05 before either rule existed (see PREREGISTRATION.md). Owners marked 'hallucinated' are invented for the corpus.",
  "clone": [
    {"id": "inf-https", "class": "inferred", "instruction": "Clone the requests library and run its tests.",
