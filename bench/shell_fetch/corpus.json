    {"id": "inf-depth", "class": "inferred", "instruction": "Get a shallow copy of the httpx source.",
     "command": "git clone --depth 1 https://github.com/encode/httpx.git"},
    {"id": "inf-branch-halluc", "class": "inferred", "instruction": "Check out the dev branch of the fastmcp project.",
