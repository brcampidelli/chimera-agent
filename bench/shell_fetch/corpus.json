    {"id": "named-url-agent-git", "class": "named", "instruction": "Clone https://github.com/encode/httpx please.",
     "command": "git clone --depth 1 https://github.com/encode/httpx.git"},
    {"id": "named-case", "class": "named", "instruction": "Clone textualize/rich.",
