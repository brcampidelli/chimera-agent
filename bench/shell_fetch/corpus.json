    {"id": "inf-ssh", "class": "inferred", "instruction": "Clone the click project over ssh.",
     "command": "git clone ssh://git@github.com/pallets/click.git"},
    {"id": "inf-gh-halluc", "class": "inferred", "instruction": "Use gh to clone the browser-use repo.",
     "command": "gh repo clone browseruse-ai/browser-use"},
    {"id": "named-slug", "class": "named", "instruction": "Clone psf/requests and run its tests.",
     "command": "git clone https://github.com/psf/requests"},
    {"id": "named-url", "class": "named", "instruction": "Clone https://github.com/encode/httpx and read the changelog.",
