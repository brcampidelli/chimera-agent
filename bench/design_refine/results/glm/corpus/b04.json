ds-space-sm)\">\n<div style=\"display:flex;justify-content:space-between;align-items:baseline\"><h2 style=\"margin:0;font-size:var(--ds-font-title-size);font-weight:var(--ds-font-title-weight)\">Morning Flow</h2><span style=\"font-size:var(--ds-font-caption-size);color:var(--ds-color-text-muted)\">7:00 – 8:00</span></div>\n<p style=\"margin:0;font-size:var(--ds-font-body-size);color:var(--ds-color-text-muted)\">Gentle vinyasa to start the day. All levels.</p>\n<div style=\"display:flex;justify-content:space-between;align-items:center\"><span style=\"font-size:var(--ds-font-caption-size);color:var(--ds-color-text-muted)\">Studio A · 12 spots left</span><button style=\"background:var(--ds-color-primary);color:var(--ds-color-on-primary);border:none;border-radius:var(--ds-radius-md);padding:var(--ds-space-sm) var(--ds-space-md);min-height:44px;font-size:var(--ds-font-label-size);font-weight:500;cursor:pointer\">Book</button></div>\n</article>\n<article class=\"card\" style=\"background:var(--ds-color-surface);border:1px solid var(--ds-color-border);border-radius:var(--ds-radius-lg);padding:var(--ds-space-lg);display:flex;flex-direction:column;gap:var(--ds-space-sm)\">\n<div style=\"display:flex;justify-content:space-between;align-items:baseline\"><h2 style=\"margin:0;font-size:var(--ds-font-title-size);font-weight:var(--ds-font-title-weight)\">Vinyasa II</h2><span style=\"font-size:var(--ds-font-caption-size);color:var(--ds-color-text-muted)\">12:15 – 13:15</span></div>\n<p style=\"margin:0;font-size:var(--ds-font-body-size);color:var(--ds-color-text-muted)\">Dynamic flow for intermediate practice.</p>\n<div style=\"display:flex;justify-content:space-between;align-items:center\"><span style=\"font-size:var(--ds-font-caption-size);color:var(--ds-color-text-muted)\">Studio B · 5 spots left</span><button style=\"background:var(--ds-color-primary);color:var(--ds-color-on-primary);border:none;border-radius:var(--ds-radius-md);padding:var(--ds-space-sm) var(--ds-space-md);min