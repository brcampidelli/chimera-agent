-ds-font-display-line-height);font-weight:var(--ds-font-display-weight)\">Find your calm, one class at a time.</h1><p style=\"margin:0;font-size:var(--ds-font-body-size);line-height:var(--ds-font-body-line-height);opacity:.9\">Book yoga classes at your neighbourhood studio — [YOUR TAGLINE].</p><button class=\"btn\" style=\"background:var(--tw-accent);color:var(--ds-color-on-accent);border:none;align-self:flex-start\">Book a class</button></section><section style=\"display:flex;flex-direction:column;gap:var(--ds-space-sm)\"><h2 style=\"margin:0;font-family:var(--ds-font-heading-family);font-size:var(--ds-font-heading-size);font-weight:var(--ds-font-heading-weight);line-height:var(--ds-font-heading-line-height)\">This week</h2><article class=\"card\" style=\"display:flex;flex-direction:column;gap:var(--ds-space-sm)\"><div style=\"display:flex;justify-content:space-between;align-items:baseline\"><h3 style=\"margin:0;font-family:var(--ds-font-title-family);font-size:var(--ds-font-title-size);font-weight:var(--ds-font-title-weight)\">Morning Flow</h3><span style=\"font-family:var(--ds-font-label-family);font-size:var(--ds-font-label-size);color:var(--ds-color-text-muted)\">Mon 7:00</span></div><p style=\"margin:0;font-size:var(--ds-font-body-size);line-height:var(--ds-font-body-line-height);color:var(--ds-color-text-muted)\">[CLASS DESCRIPTION]</p><div style=\"display:flex;justify-content:space-between;align-items:center\"><span style=\"font-family:var(--ds-font-label-family);font-size:var(--ds-font-label-size);color:var(--ds-color-text-muted)\">[YOUR PRICE]</span><button class=\"btn btn-primary\">Book</button></div></article><article class=\"card\" style=\"display:flex;flex-direction:column;gap:var(--ds-space-sm)\"><div style=\"display:flex;justify-content:space-between;align-items:baseline\"><h3 style=\"margin:0;font-family:var(--ds-font-title-family);font-size:var(--ds-font-title-size);font-weight:var(--ds-font-title-weight)\">Evening Restorative</h3><span style=\"fon