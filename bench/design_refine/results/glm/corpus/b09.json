der);border-radius:var(--ds-radius-lg);padding:var(--ds-space-lg);display:flex;flex-direction:column;gap:var(--ds-space-md);}.ph{background:var(--ds-color-border);border-radius:var(--ds-radius-md);height:160px;display:flex;align-items:center;justify-content:center;color:var(--ds-color-text-muted);font-size:var(--ds-font-caption-size);}.card h3{font-size:var(--ds-font-title-size);}.card p{margin:0;font-size:var(--ds-font-body-size);color:var(--ds-color-text-muted);}.card .btn{margin-top:auto;align-self:flex-start;}.steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:var(--ds-space-lg);}.step{background:var(--ds-color-surface);border-radius:var(--ds-radius-lg);padding:var(--ds-space-lg);border:1px solid var(--ds-color-border);}.banner{background:var(--ds-color-primary);color:var(--ds-color-on-primary);border-radius:var(--ds-radius-lg);padding:var(--ds-space-2xl);display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:var(--ds-space-lg);}.banner .btn{background:var(--ds-color-background);color:var(--ds-color-text);}.banner p{margin:0;opacity:.9;max-width:560px;}footer{border-top:1px solid var(--ds-color-border);padding:var(--ds-space-xl);display:flex;flex-wrap:wrap;gap:var(--ds-space-lg);justify-content:space-between;color:var(--ds-color-text-muted);font-size:var(--ds-font-caption-size);}@media(max-width:720px){.hero h1{font-size:36px;}header{flex-direction:column;gap:var(--ds-space-md);}}</style></head><body><header><a href=\"#home\" style=\"font-family:var(--ds-font-title-family);font-size:var(--ds-font-title-size);font-weight:600;color:var(--ds-color-primary)\">City Shelter</a><nav><a href=\"#pets\">Adopt</a><a href=\"#how\">How it works</a><a href=\"#visit\">Visit us</a></nav></header><main><section class=\"hero\" id=\"home\"><h1>Meet your new best friend</h1><p>Dogs, cats and small animals from our city shelter are looking for a home. Browse who is available today.</p><div style=\"display:flex;gap:var(--ds-space-md);flex-wrap:wrap\"><a class=\"btn btn-primary\" href=\"#pets\">Browse adoptable pets</a><a class=\"btn btn-secondary\" href=\"#visit\">Plan a visit</a></div></section><section id=\"pets\"><h2>Available for adoption</h2><div class=\"grid\"><div class=\"card\"><div class=\"ph\">Placeholder: photo of pet 1</div><h3>[PET NAME]</h3><p>[Species] · [Age] · [Temperament]</p><a class=\"btn btn-primary\" href=\"#visit\">Meet me</a></div><div class=\"card\"><div class=\"ph\">Placeholder: photo of pet 2</div><h3>[PET NAME]</h3><p>[Species] · [Age] · [Temperament]</p><a class=\"btn btn-primary\" href=\"#visit\">Meet me</a></div><div class=\"card\"><div class=\"ph\">Placeholder: photo of pet 3</div><h3>[PET NAME]</h3><p>[Species] · [Age] · [Temperament]</p><a class=\"btn btn-primary\" href=\"#visit\">Meet me</a></div><div class=\"card\"><div class=\"ph\">Placeholder: photo of pet 4</div><h3>[PET NAME]</h3><p>[Species] · [Age] · [Temperament]</p><a class=\"btn btn-primary\" href=\"#visit\">Meet me</a></div></div></section><section id=\"how\"><h2>How adoption works</h2><div class=\"steps\"><div class=\"step\"><h3 style=\"font-size:var(--ds-font-title-size)\">1. Browse</h3><p style=\"margin:var(--ds-space-sm) 0 0;font-size:var(--ds-font-body-size);color:var(--ds-color-text-muted)\">See the animals currently at the shelter.</p></div><div class=\"step\"><h3 style=\"font-size:var(--ds-font-title-size)\">2. Visit</h3><p style=\"margin:var(--ds-space-sm) 0 0;font-size:var(--ds-font-body-size);color:var(--ds-color-text-muted)\">Meet the pet in person at the shelter.</p></div><div class=\"step\"><h3 style=\"font-size:var(--ds-font-title-size)\">3. Apply</h3><p style=\"margin:var(--ds-space-sm) 0 0;font-size:var(--ds-font-body-size);color:var(--ds-color-text-muted)\">Complete a short application with our team.</p></div></div></section><section id=\"visit\"><div class=\"banner\"><p>Ready to meet someone? [SHELTER HOURS] at [SHELTER ADDRESS].</p><a class=\"btn\" href=\"#home\">Get directio