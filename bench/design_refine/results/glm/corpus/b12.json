{"brief": "b12", "tries": 4, "doc": {"schemaVersion": 2, "id": "bench-b12", "title": "A conference website for a one-day design event.", "revision": 0, "updatedAt": "2026-11-16T12:07:30+00:00", "tokens": {"colors": {"background": "#FFFFFF", "surface": "#F3F5F7", "border": "#C9D1D9", "text": "#111827", "text-muted": "#4B5563", "primary": "#0F766E", "on-primary": "#FFFFFF", "accent": "#B45309", "on-accent": "#FFFFFF", "danger": "#B91C1C", "success": "#15803D"}, "typography": {"display": {"family": "Inter, Arial, sans-serif", "size": 48.0, "weight": 700, "lineHeight": 1.1}, "heading": {"family": "Inter, Arial, sans-serif", "size": 32.0, "weight": 700, "lineHeight": 1.2}, "title": {"family": "Inter, Arial, sans-serif", "size": 24.0, "weight": 600, "lineHeight": 1.25}, "body": {"family": "Inter, Arial, sans-serif", "size": 16.0, "weight": 400, "lineHeight": 1.5}, "label": {"family": "Inter, Arial, sans-serif", "size": 14.0, "weight": 500, "lineHeight": 1.4}, "caption": {"family": "Inter, Arial, sans-serif", "size": 12.0, "weight": 400, "lineHeight": 1.4}, "mono": {"family": "JetBrains Mono, Consolas, monospace", "size": 14.0, "weight": 400, "lineHeight": 1.5}}, "spacing": {"xs": 4.0, "sm": 8.0, "md": 16.0, "lg": 24.0, "xl": 32.0, "2xl": 48.0, "3xl": 64.0}, "radii": {"none": 0.0, "sm": 4.0, "md": 10.0, "lg": 16.0, "full": 9999.0}, "components": {"button.primary": {"fill": "primary", "text": "on-primary", "radius": "md", "font": "label", "padding": "md"}, "button.secondary": {"fill": "surface", "text": "text", "stroke": "border", "radius": "md", "font": "label", "padding": "md"}, "card": {"fill": "surface", "stroke": "border", "radius": "lg", "padding": "lg"}, "heading": {"text": "text", "font": "heading"}, "body-text": {"text": "text", "font": "body"}, "caption-text": {"text": "text-muted", "font": "caption"}}}, "pages": [{"id": "home", "name": "Home", "artboards": [{"id": "ab_eb64688606c64bf7", "name": "Home", "width": 1440.0, "height": 960.0, "background": "#FFFFFF", "nodeIds": [], "html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><title>Home — Design Conference</title><style>\n:root{\n/* @tweak accent color \"Cor de destaque\" */ --tw-accent: #B45309;\n/* @tweak scale number 0.8 1.4 0.05 \"Escala do hero\" */ --tw-scale: 1;\n/* @tweak density choice \"Densidade\" \"compact\" \"comfortable\" */ --tw-density: comfortable;\n}\nbody{margin:0;font-family:var(--ds-font-body-family);color:var(--ds-color-text);background:var(--ds-color-background);line-height:var(--ds-font-body-line-height)}\n.wrap{max-width:1120px;margin:0 auto;padding:0 var(--ds-space-lg)}\n.btn{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:var(--ds-space-md) var(--ds-space-lg);border-radius:var(--ds-radius-md);font-size:var(--ds-font-label-size);font-weight:var(--ds-font-label-weight);text-decoration:none;cursor:pointer}\n.btn-primary{background:var(--ds-color-primary);color:var(--ds-color-on-primary);border:1px solid var(--ds-color-primary)}\n.btn-secondary{background:var(--ds-color-surface);color:var(--ds-color-text);border:1px solid var(--ds-color-border)}\n.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(240px,100%),1fr));gap:var(--ds-space-lg)}\n.card{background:var(--ds-color-surface);border:1px solid var(--ds-color-border);border-radius:var(--ds-radius-lg);padding:var(--ds-space-lg)}\nheader nav a{color:var(--ds-color-text);text-decoration:none;font-size:var(--ds-font-label-size);padding:12px}\n.ph{border:1px dashed var(--ds-color-border);border-radius:var(--ds-radius-md);display:flex;align-items:center;justify-content:center;color:var(--ds-color-text-muted);font-size:var(--ds-font-caption-size);background:var(--ds-color-background)}\n@media (max-width:720px){ .hero h1{font-size:calc(var(--ds-font-display-size) * 0.6 * var(--tw-scale))} }\n</style></head><body>\n<header style=\"border-bottom:1px solid var(--ds-color-border)\"><div class=\"wrap\" style=\"display:flex;align-items:center;justify-content:space-between;gap:var(--ds-space-md);padding-top:var(--ds-space-md);padding-bottom:var(--ds-space-md)\"><span style=\"font-weight:700;font-size:var(--ds-font-title-size)\">[EVENT NAME]</span><nav aria-label=\"Main\" style=\"display:flex;gap:var(--ds-space-sm)\"><a href=\"#schedule\">Schedule</a><a href=\"#speakers\">Speakers</a><a href=\"#venue\">Venue</a></nav><a class=\"btn btn-primary\" href=\"#register\">Register</a></div></header>\n<main>\n<section class=\"wrap hero\" style=\"padding-top:var(--ds-space-3xl);padding-bottom:var(--ds-space-3xl)\">\n<p style=\"margin:0 0 var(--ds-space-sm);font-size:var(--ds-font-label-size);font-weight:600;color:var(--tw-accent);letter-spacing:0.05em;text-transform:uppercase\">One-day design event</p>\n<h1 style=\"margin:0 0 var(--ds-space-md);font-size:calc(var(--ds-font-display-size) * var(--tw-scale));line-height:var(--ds-font-display-line-height);font-weight:var(--ds-font-display-weight)\">A day of craft, systems and ideas in product design</h1>\n<p style=\"margin:0 0 var(--ds-space-lg);max-width:56ch;color:var(--ds-color-text-muted);font-size:var(--ds-font-body-size)\">Talks, workshops and conversations with people shaping how we design. [DATE] — [VENUE, CITY].</p>\n<div style=\"display:flex;gap:var(--ds-space-md);flex-wrap:wrap\"><a class=\"btn btn-primary\" href=\"#register\">Get your ticket — [YOUR PRICE]</a><a class=\"btn btn-secondary\" href=\"#schedule\">View schedule</a></div>\n</section>\n<section id=\"schedule\" class=\"wrap\" style=\"padding-bottom:var(--ds-space-3xl)\">\n<h2 style=\"font-size:var(--ds-font-heading-size);font-weight:var(--ds-font-heading-weight);margin:0 0 var(--ds-space-lg)\">Programme at a glance</h2>\n<div class=\"cards\">\n<div class=\"card\"><p style=\"margin:0 0 var(--ds-space-xs);color:var(--ds-color-text-muted);font-size:var(--ds-font-caption-size)\">Morning</p><h3 style=\"margin:0 0 var(--ds-space-sm);font-size:var(--ds-font-title-size);font-weight:var(--ds-font-title-weight)\">Opening keynote</h3><p style=\"margin:0;font-size:var(--ds-font-body-size);color:var(--ds-color-text-muted)\">[Speaker name] — [Talk title placeholder]</p></div>\n<div class=\"card\"><p style=\"margin:0 0 var(--ds-space-xs);color:var(--ds-color-text-muted);font-size:var(--ds-font-caption-size)\">Midday</p><h3 style=\"margin:0 0 var(--ds-space-sm);font-size:var(--ds-font-title-size);font-weight:var(--ds-font-title-weight)\">Workshops</h3><p style=\"margin:0;font-size:var(--ds-font-body-size);color:var(--ds-color-text-muted)\">Hands-on sessions on systems, research and craft.</p></div>\n<div class=\"card\"><p style=\"margin:0 0 var(--ds-space-xs);color:var(--ds-color-text-muted);font-size:var(--ds-font-caption-size)\">Afternoon</p><h3 style=\"margin:0 0 var(--ds-space-sm);font-size:var(--ds-font-title-size);font-weight:var(--ds-font-title-weight)\">Closing panel</h3><p style=\"margin:0;font-size:var(--ds-font-body-size);color:var(--ds-color-text-muted)\">[Panel topic placeholder] with invited guests.</p></div>\n</div>\n</section>\n<section id=\"speakers\" class=\"wrap\" style=\"padding-bottom:var(--ds-space-3xl)\">\n<h2 style=\"font-size:var(--ds-font-heading-size);font-weight:var(--ds-font-heading-weight);margin:0 0 var(--ds-space-lg)\">Speakers</h2>\n<div class=\"cards\">\n<div class=\"card\" style=\"display:flex;flex-direction:column;gap:var(--ds-space-md)\"><div class=\"ph\" style=\"height:160px\">Placeholder: speaker photo</div><p style=\"margin:0\">[Speaker name]</p><p style=\"margin:0;font-size:var(--ds-font-caption-size);color:var(--ds-color-text-muted)\">[Role, company]</p></div>\n<div class=\"card\" style=\"display:flex;flex-direction:column;gap:var(--ds-space-md)\"><div class=\"ph\" style=\"height:160px\">Placeholder: speaker photo</div><p style=\"margin:0\">[Speaker name]</p><p style=\"margin:0;font-size:var(--ds-font-caption-size);color:var(--ds-color-text-muted)\">[Role, company]</p></div>\n<div class=\"card\" style=\"display:flex;flex-direction:column;gap:var(--ds-space-md)\"><div class=\"ph\" style=\"height:160px\">Placeholder: speaker photo</div><p style=\"margin:0\">[Speaker name]</p><p style=\"margin:0;font-size:var(--ds-font-caption-size);color:var(--ds-color-text-muted)\">[Role, company]</p></div>\n</div>\n</section>\n<section id=\"register\" class=\"wrap\" style=\"padding-bottom:var(--ds-space-3xl)\"><div class=\"card\" style=\"display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:var(--ds-space-lg)\"><div><h2 style=\"margin:0 0 var(--ds-space-xs);font-size:var(--ds-font-heading-size)\">Join us for one day</h2><p style=\"margin:0;color:var(--ds-color-text-muted)\">[DATE] — [VENUE, CITY]. Tickets: [YOUR PRICE].</p></div><form style=\"display:flex;gap:var(--ds-space-md);align-items:end\"><label style=\"display:flex;flex-direction:column;gap:var(--ds-space-xs);font-size:var(--ds-font-label-size)\">Email<input type=\"email\" name=\"email\" placeholder=\"you@example.com\" style=\"min-height:44px;padding:var(--ds-space-md);border:1px solid var(--ds-color-border);border-radius:var(--ds-radius-md);font-size:var(--ds-font-body-size)\"></label><button class=\"btn btn-primary\" type=\"button\">Notify me</button></form></div></section>\n</main>\n<footer style=\"border-top:1px solid var(--ds-color-border)\"><div class=\"wrap\" style=\"display:flex;justify-content:space-between;gap:var(--ds-space-md);padding-top:var(--ds-space-lg);padding-bottom:var(--ds-space-lg);color:var(--ds-color-text-muted);font-size:var(--ds-font-caption-size)\"><span>[EVENT NAME] — [CITY]</span><span><a href=\"#\" style=\"color:var(--ds-color-primary)\">Code of conduct</a> · <a href=\"#\" style=\"color:var(--ds-color-primary)\">Contact</a></span></div></footer>\n</body></html>", "mode": "fill"}, {"id": "ab_a0ee87b1a83b48fd", "name": "Speakers", "width": 1440.0, "height": 960.0, "background": "#FFFFFF", "nodeIds": [], "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"utf-8\">\n    <title>Speakers | Design Conference</title>\n    <style>\n        :root {\n            --ds-color-background: #FFFFFF;\n            --ds-color-surface: #F3F5F7;\n            --ds-color-border: #C9D1D9;\n            --ds-color-text: #111827;\n            --ds-color-text-muted: #4B5563;\n            --ds-color-primary: #0F766E;\n            --ds-color-on-primary: #FFFFFF;\n            --ds-color-accent: #B45309;\n            --ds-color-on-accent: #FFFFFF;\n            --ds-color-danger: #B91C1C;\n            --ds-color-success: #15803D;\n            --ds-font-body-family: 'Inter', Arial, sans-serif;\n            --ds-font-heading-family: 'Inter', Arial, sans-serif;\n            --ds-font-title-family: 'Inter', Arial, sans-serif;\n            --ds-space-md: 16px;\n            --ds-space-lg: 24px;\n            --ds-space-xl: 32px;\n            --ds-radius-lg: 16px;\n        }\n\n        body {\n            margin: 0;\n            padding: 0;\n            background-color: var(--ds-color-background);\n            font-family: var(--ds-font-body-family);\n            color: var(--ds-color-text);\n        }\n\n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: var(--ds-space-xl);\n        }\n\n        header {\n            text-align: center;\n            margin-bottom: var(--ds-space-xl);\n        }\n\n        .page-title {\n            font-size: 32px;\n            font-weight: 700;\n            color: var(--ds-color-text);\n            margin: 0;\n        }\n\n        .speaker-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n            gap: var(--ds-space-lg);\n            padding-bottom: var(--ds-space-xl);\n        }\n\n        .speaker-card {\n            background-color: var(--ds-color-surface);\n            border: 1px solid var(--ds-color-border);\n            border-radius: var(--ds-radius-lg);\n            padding: var(--ds-space-lg);\n            display: flex;\n            flex-direction: column;\n            transition: transform 0.2s;\n        }\n\n        .speaker-card:hover {\n            transform: translateY(-4px);\n            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);\n        }\n\n        .speaker-image-placeholder {\n            width: 100%;\n            height: 200px;\n            background-color: #E5E7EB;\n            border-radius: var(--ds-radius-lg);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: var(--ds-space-md);\n            color: var(--ds-color-text-muted);\n            font-style: italic;\n        }\n\n        .speaker-info {\n            flex-grow: 1;\n        }\n\n        .speaker-name {\n            font-size: 24px;\n            font-weight: 600;\n            margin: 0 0 4px 0;\n            color: var(--ds-color-text);\n        }\n\n        .speaker-role {\n            font-size: 16px;\n            color: var(--ds-color-primary);\n            font-weight: 500;\n            margin: 0 0 8px 0;\n        }\n\n        .speaker-bio {\n            font-size: 14px;\n            color: var(--ds-color-text-muted);\n            line-height: 1.5;\n        }\n\n        @media (max-width: 768px) {\n            .container {\n                padding: var(--ds-space-md);\n            }\n            .page-title {\n                font-size: 28px;\n            }\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <header>\n            <h1 class=\"page-title\">Speakers</h1>\n        </header>\n\n        <section class=\"speaker-grid\">\n            <div class=\"speaker-card\">\n                <div class=\"speaker-image-placeholder\">Placeholder: Speaker Photo</div>\n                <div class=\"speaker-info\">\n                    <h2 class=\"speaker-name\">Jane Doe</h2>\n                    <p class=\"speaker-role\">Keynote Speaker | Design Futurist</p>\n                    <p class=\"speaker-bio\">Jane is a renowned expert in sustainable digital design, bringing over 15 years of experience shaping industry trends. She will discuss the future of ethical UI.</p>\n                </div>\n            </div>\n\n            <div class=\"speaker-card\">\n                <div class=\"speaker-image-placeholder\">Placeholder: Speaker Photo</div>\n                <div class=\"speaker-info\">\n                    <h2 class=\"speaker-name\">John Smith</h2>\n                    <p class=\"speaker-role\">Lead UX Designer | Tech Innovator</p>\n                    <p class=\"speaker-bio\">John focuses on human-centered design solutions for large-scale enterprise applications. His talk covers accessibility in modern web development.</p>\n                </div>\n            </div>\n\n            <div class=\"speaker-card\">\n                <div class=\"speaker-image-placeholder\">Placeholder: Speaker Photo</div>\n                <div class=\"speaker-info\">\n                    <h2 class=\"speaker-name\">Alice Johnson</h2>\n                    <p class=\"speaker-role\">Creative Director | Visual Storyteller</p>\n                    <p class=\"speaker-bio\">Alice specializes in branding and visual identity for disruptive startups. She shares insights on creating memorable brand experiences.</p>\n                </div>\n            </div>\n\n            <div class=\"speaker-card\">\n                <div class=\"speaker-image-placeholder\">Placeholder: Speaker Photo</div>\n                <div class=\"speaker-info\">\n                    <h2 class=\"speaker-name\">Robert Brown</h2>\n                    <p class=\"speaker-role\">Product Manager | Growth Hacker</p>\n                    <p class=\"speaker-bio\">Robert helps companies scale their products globally. He will present a case study on rapid prototyping and market fit.</p>\n                </div>\n            </div>\n\n        </section>\n    </div>\n</body>\n</html>", "mode": "fixed"}, {"id": "ab_9ebdb17e05014c50", "name": "Schedule", "width": 1440.0, "height": 960.0, "background": "#FFFFFF", "nodeIds": [], "html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><title>Schedule — One-Day Design Event</title><style>\n:root{\n--tw-accent: #B45309;\n--tw-card-radius: 16px;\n--tw-density: comfortable;\n}\nbody{margin:0;font-family:var(--ds-font-body-family);background:var(--ds-color-background);color:var(--ds-color-text)}\n.slot{display:grid;grid-template-columns:120px 1fr;gap:var(--ds-space-lg);align-items:start}\n.card{background:var(--ds-color-surface);border:1px solid var(--ds-color-border);border-radius:var(--tw-card-radius);padding:var(--ds-space-lg)}\n.tag{display:inline-block;font-size:var(--ds-font-caption-size);font-weight:500;padding:2px 10px;border-radius:var(--ds-radius-full);background:var(--ds-color-primary);color:var(--ds-color-on-primary)}\n.tag.alt{background:var(--tw-accent);color:var(--ds-color-on-accent)}\n.tag.ghost{background:transparent;border:1px solid var(--ds-color-border);color:var(--ds-color-text-muted)}\nnav a{color:var(--ds-color-text-muted);text-decoration:none;font-size:var(--ds-font-label-size);padding:12px 16px;border-radius:var(--ds-radius-md)}\nnav a[aria-current=\"page\"]{color:var(--ds-color-primary);font-weight:600}\nnav a:hover{background:var(--ds-color-surface)}\n@media (max-width:720px){.slot{grid-template-columns:1fr}}\n</style></head><body>\n<header style=\"position:sticky;top:0;background:var(--ds-color-background);border-bottom:1px solid var(--ds-color-border);padding:var(--ds-space-md) var(--ds-space-2xl);display:flex;align-items:center;justify-content:space-between\">\n  <div style=\"font-family:var(--ds-font-title-family);font-size:var(--ds-font-title-size);font-weight:700;color:var(--ds-color-primary)\">Design Day</div>\n  <nav aria-label=\"Main\" style=\"display:flex;gap:var(--ds-space-sm)\">\n    <a href=\"#\">Home</a><a href=\"#\">Speakers</a><a href=\"#\" aria-current=\"page\">Schedule</a>\n  </nav>\n</header>\n<main style=\"max-width:1040px;margin:0 auto;padding:var(--ds-space-2xl) var(--ds-space-lg)\">\n  <h1 style=\"margin:0 0 var(--ds-space-xs);font-family:var(--ds-font-heading-family);font-size:var(--ds-font-heading-size);font-weight:700;line-height:var(--ds-font-heading-line-height)\">Schedule</h1>\n  <p style=\"margin:0 0 var(--ds-space-xl);color:var(--ds-color-text-muted);font-size:var(--ds-font-body-size)\">One day, one stage plus workshops. Times are placeholders until the final programme is confirmed.</p>\n  <div style=\"display:flex;flex-direction:column;gap:var(--ds-space-lg)\">\n    <section class=\"slot\">\n      <div style=\"font-family:var(--ds-font-mono-family);font-size:var(--ds-font-mono-size);color:var(--ds-color-text-muted);padding-top:var(--ds-space-lg)\">09:00</div>\n      <div class=\"card\"><span class=\"tag ghost\">Doors</span><h2 style=\"margin:var(--ds-space-sm) 0 0;font-size:var(--ds-font-title-size);font-weight:600\">Registration &amp; coffee</h2><p style=\"margin:var(--ds-space-xs) 0 0;color:var(--ds-color-text-muted)\">Foyer — badge pickup opens</p></div>\n    </section>\n    <section class=\"slot\">\n      <div style=\"font-family:var(--ds-font-mono-family);font-size:var(--ds-font-mono-size);color:var(--ds-color-text-muted);padding-top:var(--ds-space-lg)\">09:30</div>\n      <div class=\"card\"><span class=\"tag\">Talk</span><h2 style=\"margin:var(--ds-space-sm) 0 0;font-size:var(--ds-font-title-size);font-weight:600\">[Placeholder: opening keynote title]</h2><p style=\"margin:var(--ds-space-xs) 0 0;color:var(--ds-color-text-muted)\">Main stage — [Speaker name]</p></div>\n    </section>\n    <section class=\"slot\">\n      <div style=\"font-family:var(--ds-font-mono-family);font-size:var(--ds-font-mono-size);color:var(--ds-color-text-muted);padding-top:var(--ds-space-lg)\">10:30</div>\n      <div class=\"card\"><span class=\"tag alt\">Workshop</span><h2 style=\"margin:var(--ds-space-sm) 0 0;font-size:var(--ds-font-title-size);font-weight:600\">[Placeholder: workshop title]</h2><p style=\"margin:var(--ds-space-xs) 0 0;color:var(--ds-color-text-muted)\">Studio room — limited seats, sign-up at desk</p></div>\n    </section>\n    <section class=\"slot\">\n      <div style=\"font-family:var(--ds-font-mono-family);font-size:var(--ds-font-mono-size);color:var(--ds-color-text-muted);padding-top:var(--ds-space-lg)\">12:30</div>\n      <div class=\"card\"><span class=\"tag ghost\">Break</span><h2 style=\"margin:var(--ds-space-sm) 0 0;font-size:var(--ds-font-title-size);font-weight:600\">Lunch</h2><p style=\"margin:var(--ds-space-xs) 0 0;color:var(--ds-color-text-muted)\">Cafeteria</p></div>\n    </section>\n    <section class=\"slot\">\n      <div style=\"font-family:var(--ds-font-mono-family);font-size:var(--ds-font-mono-size);color:var(--ds-color-text-muted);padding-top:var(--ds-space-lg)\">13:30</div>\n      <div class=\"card\"><span class=\"tag\">Talk</span><h2 style=\"margin:var(--ds-space-sm) 0 0;font-size:var(--ds-font-title-size);font-weight:600\">[Placeholder: afternoon talk title]</h2><p style=\"margin:var(--ds-space-xs) 0 0;color:var(--ds-color-text-muted)\">Main stage — [Speaker name]</p></div>\n    </section>\n    <section class=\"slot\">\n      <div style=\"font-family:var(--ds-font-mono-family);font-size:var(--ds-font-mono-size);color:var(--ds-color-text-muted);padding-top:var(--ds-space-lg)\">16:00</div>\n      <div class=\"card\"><span class=\"tag\">Panel</span><h2 style=\"margin:var(--ds-space-sm) 0 0;font-size:var(--ds-font-title-size);font-weight:600\">[Placeholder: closing panel title]</h2><p style=\"margin:var(--ds-space-xs) 0 0;color:var(--ds-color-text-muted)\">Main stage — [Panelists]</p></div>\n    </section>\n  </div>\n  <div style=\"margin-top:var(--ds-space-xl);display:flex;gap:var(--ds-space-md)\">\n    <button style=\"background:var(--ds-color-primary);color:var(--ds-color-on-primary);border:none;border-radius:var(--ds-radius-md);padding:var(--ds-space-md) var(--ds-space-lg);f