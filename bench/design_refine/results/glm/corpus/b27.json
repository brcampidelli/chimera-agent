ary{background:var(--ds-color-surface);color:var(--ds-color-text);border:1px solid var(--ds-color-border)}\n.density-comfortable .article-body>*+*{margin-top:var(--ds-space-md)}\n.density-compact .article-body>*+*{margin-top:var(--ds-space-sm)}\n@media (max-width:900px){.layout{grid-template-columns:1fr!important}.sidebar{display:none}}\n</style></head><body class=\"density-comfortable\">\n<header style=\"display:flex;align-items:center;gap:var(--ds-space-lg);padding:var(--ds-space-md) var(--ds-space-xl);border-bottom:1px solid var(--ds-color-border);background:var(--ds-color-background)\">\n<div style=\"font-family:var(--ds-font-title-family);font-size:var(--ds-font-title-size);font-weight:var(--ds-font-title-weight);color:var(--tw-accent)\">Support</div>\n<nav style=\"display:flex;gap:var(--ds-space-lg);font-family:var(--ds-font-label-family);font-size:var(--ds-font-label-size)\"><a href=\"#\">Help centre</a><a href=\"#\">Contact</a><a href=\"#\">Status</a></nav>\n<div style=\"margin-left:auto;display:flex;gap:var(--ds-space-sm)\"><input aria-label=\"Search articles\" placeholder=\"Search articles…\" style=\"min-height:44px;padding:var(--ds-space-sm) var(--ds-space-md);border:1px solid var(--ds-color-border);border-radius:var(--ds-radius-md);font-family:var(--ds-font-body-family);font-size:var(--ds-font-body-size);width:240px\"><button class=\"btn btn-primary\">Sign in</button></div>\n</header>\n<main class=\"layout\" style=\"display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:var(--ds-space-2xl);padding:var(--ds-space-xl);max-width:1200px;margin:0 auto\">\n<article style=\"transform:scale(var(--tw-scale));transform-origin:top left\">\n<nav aria-label=\"Breadcrumb\" style=\"font-family:var(--ds-font-caption-family);font-size:var(--ds-font-caption-size);color:var(--ds-color-text-muted);margin-bottom:var(--ds-space-md)\"><a href=\"#\">Help centre</a> &gt; <a href=\"#\">Getting started</a> &gt; <span style=\"color:var(--ds-color-text)\">Article title</span></nav>\n<h1 style=\"margin:0 0 var(--ds-space-sm);font-family:var(--ds-font-heading-family);font-size:var(--ds-font-heading-size);font-weight:var(--ds-font-heading-weight);line-height:var(--ds-font-heading-line-height);color:var(--ds-color-text)\">[ARTICLE TITLE — PLACEHOLDER]</h1>\n<p style=\"margin:0 0 var(--ds-space-lg);font-family:var(--ds-font-caption-family);font-size:var(--ds-font-caption-size);color:var(--ds-color-text-muted)\">Last updated: [DATE] · Reading time: [X] min</p>\n<div class=\"article-body\" style=\"max-width:70ch;font-size:calc(var(--ds-font-body-size)*var(--tw-scale));line-height:var(--ds-font-body-line-height)\">\n<p style=\"margin:0 0 var(--ds-space-md)\">[INTRO PARAGRAPH PLACEHOLDER — one or two sentences summarising what the reader will learn.]</p>\n<h2 style=\"margin:var(--ds-space-lg) 0 var(--ds-space-sm);font-family:var(--ds-font-title-family);font-size:var(--ds-font-title-size);font-weight:var(--ds-font-title-weight);color:var(--ds-color-text)\">Section heading</h2>\n<p style=\"margin:0 0 var(--ds-space-md)\">[BODY PARAGRAPH PLACEHOLDER — explain the step in plain language.]</p>\n<pre style=\"margin:0 0 var(--ds-space-md);padding:var(--ds-space-md);background:#111827;color:#F3F5F7;border-radius:var(--ds-radius-md);font-family:var(--ds-font-mono-family);font-size:var(--ds-font-mono-size);line-height:var(--ds-font-mono-line-height);overflow:auto\"><code>command --example</code></pre>\n<div style=\"margin:0 0 var(--ds-space-md);padding:var(--ds-space-md);background:var(--ds-color-surface);border-left:4px solid var(--tw-accent);border-radius:var(--ds-radius-sm)\"><strong>Note:</strong> [CALLOUT TEXT PLACEHOLDER — a tip or warning relevant to this step.]</div>\n<h2 style=\"margin:var(--ds-space-lg) 0 var(--ds-space-sm);font-family:var(--ds-font-title-family);font-size:var(--ds-font-title-size);font-weight:var(--ds-font-title-weight);color:var(--ds-color-text)\">Another section</h2>\n<p style=\"margin:0 0 var(--ds-space-md)\">[BODY PARAGRAPH PLACEHOLDER.]</p>\n</div>\n<div style=\"margin-top:var(--ds-space-xl);padding:var(--ds-space-lg);background:var(--ds-color-surface);border:1px solid var(--ds-color-border);border-radius:var(--ds-radius-lg);display:flex;align-items:center;gap:var(--ds-space-md);flex-wrap:wrap\">\n<span style=\"font-family:var(--ds-font-label-family);font-size:var(--ds-font-label-size);font-weight:var(--ds-font-label-weight)\">Was this article helpful?</span>\n<button class=\"btn btn-secondary\">Yes</button><button class=\"btn btn-secondary\">No</button>\n</div>\n</article>\n<aside class=\"sidebar\">\n<div style=\"padding:var(--ds-space-lg);background:var(--ds-color-surface);border:1px solid var(--ds-color-border);border-radius:var(--ds-radius-lg)\">\n<h2 style=\"margin:0 0 var(--ds-space-md);font-family:var(--ds-font-title-family);font-size:var(--ds-font-title-size);font-weight:var(--ds-font-title-weight);color:var(--ds-color-text)\">Related articles</h2>\n<ul style=\"margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:var(--ds-space-sm);font-family:var(--ds-font-label-family);font-size:var(--ds-font-label-size)\">\n<li><a href=\"#\">[RELATED ARTICLE TITLE]</a></li>\n<li><a href=\"#\">[RELATED ARTICLE TITLE]</a></li>\n<li><a href=\"#\">[RELATED ARTICLE TITLE]</a></li>\n</ul>\n</div>\n<div style=\"margin-top:var(--ds-space-md);padding:var(--ds-space-lg);background:var(--ds-color-surface);border:1px solid var(--ds-color-border);border-radius:var(--ds-radius-lg)\">\n<h2 style=\"margin:0 0 var(--ds-space-sm);font-family:var(--ds-font-title-family);font-size:var(--ds-font-title-size);font-weight:var(--ds-font-title-weight);color:var(--ds-color-text)\">Still need help?</h2>\n<p style=\"margin:0 0 var(--ds-space-md);font-family:var(--ds-font-body-family);font-size:var(--ds-font-body-size);color:var(--ds-color-text-muted)\">Our support team is ready to assist.</p>\n<button class=\"btn btn-primary\" style=\"width:100%\">Contact support</button>\n</div>\n</aside>\n</main>\n</body></html>", "mode": "fixed"}, {"id": "ab_6e75d78d25c84ee4", "name": "Contact", "width": 1440.0, "height": 1024.0, "background": "#FFFFFF", "nodeIds": [], "html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><title>Contact — Support Portal</title><style>body{margin:0;font-family:var(--ds-font-body-family);background:var(--ds-color-background);color:var(--ds-color-text)}a{color:var(--ds-color-primary)}/* @tweak accent color \"Cor de destaque\" */ --tw-accent: #0F766E;/* @tweak density choice \"Densidade\" \"compact\" \"comfortable\" */ --tw-density: comfortable;:root{--pad:calc(var(--ds-space-lg) * var(--tw-density,1))}.card{background:var(--ds-color-surface);border:1px solid var(--ds-color-border);border-radius:var(--ds-radius-lg);padding:var(--ds-space-lg)}.field{display:flex;flex-direction:column;gap:var(--ds-space-xs);margin-bottom:var(--ds-space-md)}input,select,textarea{font:var(--ds-font-body-size)/1.5 var(--ds-font-body-family);padding:12px;border:1px solid var(--ds-color-border);border-radius:var(--ds-radius-md);background:#fff;color:var(--ds-color-text)}input:focus,textarea:focus,select:focus{outline:2px solid var(--tw-accent);outline-offset:1px}.btn{min-height:44px;padding:var(--ds-space-md) var(--ds-space-xl);background:var(--ds-color-primary);color:var(--ds-color-on-primary);border:none;border-radius:var(--ds-radius-md);font:500 var(--ds-font-label-size)/1.4 var(--ds-font-label-family);cursor:pointer}.btn:hover{filter:brightness(1.08)}</style></head><body><header style=\"display:flex;align-items:center;justify-content:space-between;padding:var(--ds-space-md) var(--ds-space-2xl);border-bottom:1px solid var(--ds-color-border)\"><div style=\"display:flex;align-items:center;gap:var(--ds-space-md)\"><div style=\"width:32px;height:32px;border-radius:var(--ds-radius-sm);background:var(--ds-color-primary)\"></div><span style=\"font:600 var(--ds-font-title-size)/1.25 var(--ds-font-title-family)\">Support Portal</span></div><nav style=\"display:flex;gap:var(--ds-space-lg)\"><a href=\"#\" style=\"font:500 var(--ds-font-label-size)/1.4 var(--ds-font-label-family);text-decoration:none;color:var(--ds-color-text-muted)\">Help centre</a><a href=\"#\" style=\"font:500 var(--ds-font-label-size)/1.4 var(--ds-font-label-family);text-decoration:none;color:var(--ds-color-primary);border-bottom:2px solid var(--ds-color-primary);padding-bottom:2px\">Contact</a></nav></header><main style=\"max-width:1120px;margin:0 auto;padding:var(--ds-space-2xl) var(--ds-space-lg);display:grid;grid-template-columns:minmax(320px,1fr) minmax(360px,1.4fr);gap:var(--ds-space-2xl)\"><section><h1 style=\"margin:0 0 var(--ds-space-sm);font:700 var(--ds-font-heading-size)/1.2 var(--ds-font-heading-family)\">Contact support</h1><p style=\"margin:0 0 var(--ds-space-lg);font:var(--ds-font-body-size)/1.5 var(--ds-font-body-family);color:var(--ds-color-text-muted)\">Can't find what you need in the Help centre? Send us a message and our team will get back to you.</p><div style=\"display:flex;flex-direction:column;gap:var(--ds-space-md)\"><div class=\"card\"><h2 style=\"margin:0 0 var(--ds-space-xs);font:600 var(--ds-font-title-size)/1.25 var(--ds-font-title-family)\">Email</h2><p style=\"margin:0;font:var(--ds-font-body-size)/1.5 var(--ds-font-body-family);color:var(--ds-color-text-muted)\">[SUPPORT EMAIL ADDRESS]</p></div><div class=\"card\"><h2 style=\"margin:0 0 var(--ds-space-xs);font:600 var(--ds-font-title-size)/1.25 var(--ds-font-title-family)\">Live chat</h2><p style=\"margin:0;font:var(--ds-font-body-size)/1.5 var(--ds-font-body-family);color:var(--ds-color-text-muted)\">[CHAT AVAILABILITY HOURS]</p></div><div class=\"card\"><h2 style=\"margin:0 0 var(--ds-space-xs);font:600 var(--ds-font-title-size)/1.25 var(--ds-font-title-family)\">Status page</h2><p style=\"margin:0;font:var(--ds-font-body-size)/1.5 var(--ds-font-body-family);color:var(--ds-color-text-muted)\">Check current service status at <a href=\"https://example.com\" style=\"color:var(--ds-color-primary)\">[STATUS PAGE LINK]</a>.</p></div></div></section><section class=\"card\" aria-label=\"Contact form\"><h2 style=\"margin:0 0 var(--ds-space-lg);font:600 var(--ds-font-title-size)/1.25 var(--ds-font-title-family)\">Send a message</h2><form><div class=\"field\"><label for=\"name\" style=\"font:500 var(--ds-font-label-size)/1.4 var(--ds-font-label-family)\">Full name</label><input id=\"name\" name=\"name\" type=\"text\" placeholder=\"Your name\"></div><div class=\"field\"><label for=\"email\" style=\"font:500 var(--ds-font-label-size)/1.4 var(--ds-font-label-family)\">Email</label><input id=\"email\" name=\"email\" type=\"email\" placeholder=\"you@company.com\"></div><div class=\"field\"><label for=\"topic\" style=\"font:500 var(--ds-font-label-size)/1.4 var(--ds-font-label-family)\">Topic</label><select id=\"topic\" name=\"topic\"><option>Billing</option><option>Technical issue</option><option>Account</option><option>Other</option></select></div><div class=\"field\"><label for=\"message\" style=\"font:500 var(--ds-font-label-size)/1.4 var(--ds-font-label-family)\">Message</label><textarea id=\"message\" name=\"message\" rows=\"6\" placeholder=\"Describe your issue\"></textarea></div><button class=\"btn\" type=\"submit\">Send message</button></form></section></main><footer style=\"padding:var(--ds-space-lg) var(--ds-space-2xl);border-top:1px solid var(--ds-color-border)\"><p style=\"margin:0;font:var(--ds-font-caption-size)/1.4 var(--ds-font-caption-family);color:var(--ds-color-text-muted)\">© [COMPANY NAME] — Support Portal</p></footer></body></html>", "mode": "fixed"}, {"id": "ab_8bd11863ca874828", "name": "My tickets", "width": 1440.0, "height": 1024.0, "background": "#FFFFFF", "nodeIds": [], "html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><title>My tickets — Support portal</title><style>\n:root{\n  --tw-accent: #0F766E;\n  --tw-row-density: 64px;\n}\nbody{margin:0;font-family:var(--ds-font-body-family);backgroun