city 0.2s;\n      min-height: 44px;\n    }\n    .btn-primary:hover {\n      opacity: 0.9;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"app-container\">\n    <header>\n      <h1 style=\"font-size: 32px; font-weight: 700; margin: 0; color: var(--ds-color-text); text-align: center;\">Upcoming Events</h1>\n    </header>\n\n    <div class=\"event-card\">\n      <div class=\"event-details\">\n        <h2 class=\"event-title\">The Midnight Jazz Collective</h2>\n        <div class=\"event-meta\">\n          <span>Saturday, Oct 28</span>\n          <span>The Blue Note Venue</span>\n        </div>\n        <div class=\"event-meta\">\n          <span>Doors at 8:00 PM</span>\n          <span>Tickets: [YOUR PRICE]</span>\n        </div>\n      </div>\n      <div class=\"event-actions\">\n        <button class=\"btn-primary\">Book Tickets</button>\n      </div>\n    </div>\n\n    <div class=\"event-card\">\n      <div class=\"event-details\">\n        <h2 class=\"event-title\">Indie Rock Showcase: Echoes</h2>\n        <div class=\"event-meta\">\n          <span>Friday, Nov 3</span>\n          <span>The Basement Club</span>\n        </div>\n        <div class=\"event-meta\">\n          <span>Doors at 7:30 PM</span>\n          <span>Tickets: [YOUR PRICE]</span>\n        </div>\n      </div>\n      <div class=\"event-actions\">\n        <button class=\"btn-primary\">Book Tickets</button>\n      </div>\n    </div>\n\n    <div class=\"event-card\">\n      <div class=\"event-details\">\n        <h2 class=\"event-title\">Acoustic Night with Sarah J.</h2>\n        <div class=\"event-meta\">\n          <span>Sunday, Nov 10</span>\n          <span>The Corner Cafe</span>\n        </div>\n        <div class=\"event-meta\">\n          <span>Doors at 6:00 PM</span>\n          <span>Tickets: [YOUR PRICE]</span>\n        </div>\n      </div>\n      <div class=\"event-actions\">\n        <button class=\"btn-primary\">Book Tickets</button>\n      </div>\n    </div>\n\n  </div>\n</body>\n</h