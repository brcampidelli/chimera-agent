{"brief": "b11", "tries": 4, "doc": {"schemaVersion": 2, "id": "bench-b11", "title": "A mobile banking app for teenagers with parental controls.", "revision": 0, "updatedAt": "2026-11-16T12:07:30+00:00", "tokens": {"colors": {"background": "#FFFFFF", "surface": "#F3F5F7", "border": "#C9D1D9", "text": "#111827", "text-muted": "#4B5563", "primary": "#0F766E", "on-primary": "#FFFFFF", "accent": "#B45309", "on-accent": "#FFFFFF", "danger": "#B91C1C", "success": "#15803D"}, "typography": {"display": {"family": "Inter, Arial, sans-serif", "size": 48.0, "weight": 700, "lineHeight": 1.1}, "heading": {"family": "Inter, Arial, sans-serif", "size": 32.0, "weight": 700, "lineHeight": 1.2}, "title": {"family": "Inter, Arial, sans-serif", "size": 24.0, "weight": 600, "lineHeight": 1.25}, "body": {"family": "Inter, Arial, sans-serif", "size": 16.0, "weight": 400, "lineHeight": 1.5}, "label": {"family": "Inter, Arial, sans-serif", "size": 14.0, "weight": 500, "lineHeight": 1.4}, "caption": {"family": "Inter, Arial, sans-serif", "size": 12.0, "weight": 400, "lineHeight": 1.4}, "mono": {"family": "JetBrains Mono, Consolas, monospace", "size": 14.0, "weight": 400, "lineHeight": 1.5}}, "spacing": {"xs": 4.0, "sm": 8.0, "md": 16.0, "lg": 24.0, "xl": 32.0, "2xl": 48.0, "3xl": 64.0}, "radii": {"none": 0.0, "sm": 4.0, "md": 10.0, "lg": 16.0, "full": 9999.0}, "components": {"button.primary": {"fill": "primary", "text": "on-primary", "radius": "md", "font": "label", "padding": "md"}, "button.secondary": {"fill": "surface", "text": "text", "stroke": "border", "radius": "md", "font": "label", "padding": "md"}, "card": {"fill": "surface", "stroke": "border", "radius": "lg", "padding": "lg"}, "heading": {"text": "text", "font": "heading"}, "body-text": {"text": "text", "font": "body"}, "caption-text": {"text": "text-muted", "font": "caption"}}}, "pages": [{"id": "home", "name": "Home", "artboards": [{"id": "ab_b806bb2216474380", "name": "Home", "width": 390.0, "height": 844.0, "background": "#FFFFFF", "nodeIds": [], "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<title>Home</title>\n<style>\n  /* @tweak accent color \"Cor de destaque\" */\n  --tw-accent: #B45309;\n  :root {\n    --tw-accent: #B45309;\n  }\n  * { box-sizing: border-box; }\n  body { margin: 0; font-family: var(--ds-font-body-family); background: var(--ds-color-background); color: var(--ds-color-text); }\n  .screen { width: 390px; height: 844px; margin: 0 auto; display: flex; flex-direction: column; background: var(--ds-color-background); }\n  main { flex: 1; overflow: hidden; padding: var(--ds-space-lg); display: flex; flex-direction: column; gap: var(--ds-space-md); }\n  .topbar { display: flex; align-items: center; justify-content: space-between; }\n  .avatar { width: 44px; height: 44px; border-radius: var(--ds-radius-full); background: var(--ds-color-primary); color: var(--ds-color-on-primary); display: flex; align-items: center; justify-content: center; font-weight: 700; }\n  .balance-card { background: var(--ds-color-primary); color: var(--ds-color-on-primary); border-radius: var(--ds-radius-lg); padding: var(--ds-space-lg); }\n  .balance-card .amount { font-size: var(--ds-font-display-size); font-weight: 700; line-height: 1.1; }\n  .quick-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--ds-space-sm); }\n  .quick-btn { min-height: 72px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--ds-space-xs); background: var(--ds-color-surface); border: 1px solid var(--ds-color-border); border-radius: var(--ds-radius-md); font-family: var(--ds-font-label-family); font-size: var(--ds-font-label-size); color: var(--ds-color-text); cursor: pointer; padding: var(--ds-space-sm); }\n  .quick-btn .ico { width: 24px; height: 24px; border-radius: var(--ds-radius-full); background: var(--ds-color-primary); }\n  .banner { display: flex; align-items: center; gap: var(--ds-space-sm); background: var(--ds-color-surface); border: 1px solid var(--ds-color-border); border-left: 4px solid var(--tw-accent); border-radius: var(--ds-radius-md); padding: var(--ds-space-md); }\n  .banner .dot { width: 10px; height: 10px; border-radius: var(--ds-radius-full); background: var(--ds-color-success); flex: none; }\n  .tx { display: flex; align-items: center; justify-content: space-between; gap: var(--ds-space-md); padding: var(--ds-space-sm) 0; border-bottom: 1px solid var(--ds-color-border); }\n  .tx:last-child { border-bottom: none; }\n  .tx .who { display: flex; align-items: center; gap: var(--ds-space-sm); }\n  .tx .glyph { width: 36px; height: 36px; border-radius: var(--ds-radius-full); background: var(--ds-color-surface); border: 1px solid var(--ds-color-border); flex: none; }\n  .pos { color: var(--ds-color-success); font-weight: 600; }\n  .neg { color: var(--ds-color-text); font-weight: 600; }\n  .nav { display: flex; border-top: 1px solid var(--ds-color-border); background: var(--ds-color-background); }\n  .nav a { flex: 1; min-height: 56px; display: flex; align-items: center; justify-content: center; font-family: var(--ds-font-label-family); font-size: var(--ds-font-label-size); color: var(--ds-color-text-muted); text-decoration: none; }\n  .nav a.active { color: var(--ds-color-primary); font-weight: 700; }\n  .section-head { display: flex; align-items: baseline; justify-content: space-between; }\n  .ph { border: 1px dashed var(--ds-color-border); border-radius: var(--ds-radius-md); color: var(--ds-color-text-muted); font-family: var(--ds-font-caption-family); font-size: var(--ds-font-caption-size); display: flex; align-items: center; justify-content: center; text-align: center; padding: var(--ds-space-sm); }\n</style>\n</head>\n<body>\n<div class=\"screen\">\n  <main>\n    <div class=\"topbar\">\n      <div>\n        <div style=\"font-family:var(--ds-font-label-family);font-size:var(--ds-font-label-size);color:var(--ds-color-text-muted)\">Good afternoon</div>\n        <div style=\"font-family:var(--ds-font-title-family);font-size:var(--ds-font-title-size);font-weight:var(--ds-font-title-weight)\">Hi, Alex</div>\n      </div>\n      <div class=\"avatar\" aria-label=\"Profile\">A</div>\n    </div>\n\n    <section class=\"balance-card\">\n      <div style=\"font-family:var(--ds-font-label-family);font-size:var(--ds-font-label-size);opacity:.9\">Total balance</div>\n      <div class=\"amount\">[YOUR BALANCE]</div>\n      <div style=\"display:flex;gap:var(--ds-space-sm);margin-top:var(--ds-space-md)\">\n        <button style=\"flex:1;min-height:44px;background:var(--ds-color-on-primary);color:var(--ds-color-primary);border:none;border-radius:var(--ds-radius-md);font-family:var(--ds-font-label-family);font-size:var(--ds-font-label-size);font-weight:500;cursor:pointer\">Add money</button>\n        <button style=\"flex:1;min-height:44px;background:transparent;color:var(--ds-color-on-primary);border:1px solid var(--ds-color-on-primary);border-radius:var(--ds-radius-md);font-family:var(--ds-font-label-family);font-size:var(--ds-font-label-size);font-weight:500;cursor:pointer\">Send</button>\n      </div>\n    </section>\n\n    <section class=\"quick-grid\" aria-label=\"Quick actions\">\n      <button class=\"quick-btn\"><span class=\"ico\"></span>Card</button>\n      <button class=\"quick-btn\"><span class=\"ico\"></span>Goals</button>\n      <button class=\"quick-btn\"><span class=\"ico\"></span>Requests</button>\n      <button class=\"quick-btn\"><span class=\"ico\"></span>More</button>\n    </section>\n\n    <section class=\"banner\">\n      <span class=\"dot\"></span>\n      <div>\n        <div style=\"font-family:var(--ds-font-label-family);font-size:var(--ds-font-label-size);font-weight:500\">Parental controls on</div>\n        <div style=\"font-family:var(--ds-font-caption-family);font-size:var(--ds-font-caption-size);color:var(--ds-color-text-muted)\">Spending limits set by your parent. <a href=\"#\" style=\"color:var(--ds-color-primary)\">View rules</a></div>\n      </div>\n    </section>\n\n    <section>\n      <div class=\"section-head\">\n        <h2 style=\"margin:0;font-family:var(--ds-font-title-family);font-size:var(--ds-font-title-size);font-weight:var(--ds-font-title-weight)\">Recent activity</h2>\n        <a href=\"#\" style=\"font-family:var(--ds-font-label-family);font-size:var(--ds-font-label-size);color:var(--ds-color-primary);text-decoration:none\">See all</a>\n      </div>\n      <div style=\"margin-top:var(--ds-space-sm)\">\n        <div class=\"tx\">\n          <div class=\"who\"><span class=\"glyph\"></span><div><div style=\"font-family:var(--ds-font-label-family);font-size:var(--ds-font-label-size)\">[MERCHANT NAME]</div><div style=\"font-family:var(--ds-font-caption-family);font-size:var(--ds-font-caption-size);color:var(--ds-color-text-muted)\">Today</div></div></div>\n          <span class=\"neg\">- [AMOUNT]</span>\n        </div>\n        <div class=\"tx\">\n          <div class=\"who\"><span class=\"glyph\"></span><div><div style=\"font-family:var(--ds-font-label-family);font-size:var(--ds-font-label-size)\">[ALLOWANCE SOURCE]</div><div style=\"font-family:var(--ds-font-caption-family);font-size:var(--ds-font-caption-size);color:var(--ds-color-text-muted)\">Yesterday</div></div></div>\n          <span class=\"pos\">+ [AMOUNT]</span>\n        </div>\n        <div class=\"tx\">\n          <div class=\"who\"><span class=\"glyph\"></span><div><div style=\"font-family:var(--ds-font-label-family);font-size:var(--ds-font-label-size)\">[MERCHANT NAME]</div><div style=\"font-family:var(--ds-font-caption-family);font-size:var(--ds-font-caption-size);color:var(--ds-color-text-muted)\">[DATE]</div></div></div>\n          <span class=\"neg\">- [AMOUNT]</span>\n        </div>\n      </div>\n    </section>\n\n    <div class=\"ph\" style=\"flex:1\">Placeholder: weekly spending summary chart</div>\n  </main>\n\n  <nav class=\"nav\" aria-label=\"Main navigation\">\n    <a href=\"#\" class=\"active\">Home</a>\n    <a href=\"#\">Card</a>\n    <a href=\"#\">Goals</a>\n    <a href=\"#\">Learn</a>\n    <a href=\"#\">Profile</a>\n  </nav>\n</div>\n</body>\n</html>", "mode": "fixed"}, {"id": "ab_2b591a70dcb344ab", "name": "Spending", "width": 390.0, "height": 844.0, "background": "#FFFFFF", "nodeIds": [], "html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><title>Spending</title><style>\n:root{\n /* @tweak accent color \"Cor de destaque\" */ --tw-accent: #B45309;\n /* @tweak scale number 0.9 1.2 0.05 \"Escala do cartão de resumo\" */ --tw-scale: 1;\n /* @tweak density choice \"Densidade\" \"compact\" \"comfortable\" */ --tw-density: comfortable;\n}\n.sp-row{display:flex;align-items:center;gap:var(--ds-space-md)}\n.sp-row--compact{padding-block:calc(var(--ds-space-md) * 0.6)}\n@media (max-width: 359px){ .sp-bar-wrap{display:none} }\n</style></head><body style=\"margin:0;font-family:var(--ds-font-body-family);background:var(--ds-color-background);color:var(--ds-color-text)\">\n<main style=\"display:flex;flex-direction:column;height:844px;background:var(--ds-color-background);color:var(--ds-color-text)\">\n  <header style=\"display:flex;align-items:center;justify-content:space-between;padding:var(--ds-space-lg) var(--ds-space-lg) var(--ds-space-md)\">\n    <button aria-label=\"Back to Home\" style=\"width:44px;height:44px;border:1px solid var(--ds-color-border);background:var(--ds-color-surface);border-radius:var(--ds-radius-md);color:var(--ds-color-text);font-size:18px;cursor:pointer\">&larr;</button>\n    <h1 style=\"margin:0;font-family:var(--ds-font-title-family);font-size:var(--ds-font-title-size);font-weight:var(--ds-font-title-weight);line-height:var(--ds-font-title-line-height);color:var(--ds-color-text)\">Spending</h1>\n    <button aria-label=\"Spending options\" style=\"width:44px;height:44px;border:1px solid var(--ds-color-border);background:var(--ds-color-surface);border-radius:var(--ds-radius-md);color:var(--ds-color-text);font-size:18px;cursor:pointer\">&#8942;</button>\n  </header>\n\n  <section aria-label=\"Monthly summary\" style=\"margin:0 var(--ds-space-lg);padding:var(--ds-space-lg);background:var(--ds-color-surface);border:1px solid var(--ds-color-border);border-radius:var(--ds-radius-lg);transform:scale(var(--tw-scale));transform-origin:top center\">\n    <p style=\"margin:0;font-size:var(--ds-font-label-size);color:var(--ds-color-text-muted)\">This month</p>\n    <p style=\"margin:var(--ds-space-xs) 0 0;font-family:var(--ds-font-display-family);font-size:var(--ds-font-display-size);font-weight:var(--ds-font-display-weight);line-height:var(--ds-font-display-line-height);color:var(--ds-color-text)\">[YOUR TOTAL]</p>\n    <p style=\"margin:var(--ds-space-xs) 0 0;font-size:var(--ds-font-caption-size);color:var(--ds-color-text-muted)\">of [YOUR BUDGET] monthly allowance</p>\n    <div role=\"img\" aria-label=\"Spending progress bar\" style=\"margin-top:var(--ds-space-md);height:10px;background:var(--ds-color-border);border-radius:var(--ds-radius-full);overflow:hidden\">\n      <div style=\"width:38%;height:100%;background:var(--ds-color-primary);border-radius:var(--ds-radius-full)\"></div>\n    </div>\n  </section>\n\n  <section aria-label=\"Spending by category\" style=\"margin:var(--ds-space-lg) var(--ds-space-lg) 0;padding:var(--ds-space-lg);background:var(--ds-color-surface);border:1px solid var(--ds-color-border);border-radius:var(--ds-radius-lg)\">\n    <h2 style=\"margin:0 0 var(--ds-space-md);font-family:var(--ds-font-title-family);font-size:20px;font-weight:600;line-height:var(--ds-font-title-line-height);color:var(--ds-color-text)\">By category</h2>\n    <div style=\"display:flex;flex-direction:column;gap:var(--ds-space-md)\">\n      <div><div class=\"sp-row\"><span style=\"flex:1;font-size:var(--ds-font-label-size);font-weight:500\">Food &amp; drinks</span><span style=\"font-family:var(--ds-font-mono-family);font-size:var(--ds-font-mono-size)\">[AMOUNT]</span></div><div style=\"margin-top:var(--ds-space-xs);height:6px;background:var(--ds-color-border);border-radius:var(--ds-radius-full)\"><div style=\"width:45%;height:100%;background:var(--ds-color-primary);border-radius:var(--ds-radius-full)\"></div></div></div>\n      <div><div class=\"sp-row\"><span style=\"flex:1;font-size:var(--ds-font-label-size);font-weight:500\">Transport</span><span style=\"font-family:var(--ds-font-mono-family);font-size:var(--ds-font-mono-size)\">[AMOUNT]</span></div><div style=\"margin-top:var(--ds-space-xs);height:6px;background:var(--ds-color-border);border-radius:var(--ds-radius-full)\"><div style=\"width:25%;height:100%;background:var(--ds-color-primary);border-radius:var(--ds-radius-full)\"></div></div></div>\n      <div><div class=\"sp-row\"><span style=\"flex:1;font-size:var(--ds-font-label-size);font-weight:500\">Games &amp; apps</span><span style=\"font-family:var(--ds-font-mono-family);font-size:var(--ds-font-mono-size)\">[AMOUNT]</span></div><div style=\"margin-top:var(--ds-space-xs);height:6px;background:var(--ds-color-border);border-radius:var(--ds-radius-full)\"><div style=\"width:18%;height:100%;background:var(--tw-accent);border-radius:var(--ds-radius-full)\"></div></div></div>\n    </div>\n  </section>\n\n  <section aria-label=\"Recent transactions\" style=\"flex:1;margin:var(--ds-space-lg) var(--ds-space-lg) 0;min-height:0\">\n    <h2 style=\"margin:0 0 var(--ds-space-md);font-family:var(--ds-font-title-family);font-size:20px;font-weight:600;line-height:var(--ds-font-title-line-height);color:var(--ds-color-text)\">Recent</h2>\n    <ul style=\"list-style:none;margin:0;padding:0;display:flex;flex-direction:column\">\n      <li class=\"sp-row sp-row--compact\" style=\"padding:var(--ds-space-md) 0;border-bottom:1px solid var(--ds-color-border)\"><span aria-hidden=\"true\" style=\"width:40px;height:40px;border-radius:var(--ds-radius-full);background:var(--ds-color-surface);border:1px solid var(--ds-color-border);display:flex;align-items:center;justify-content:center;font-size:var(--ds-font-label-size);font-weight:600;color:var(--ds-color-text-muted)\">P1</span><span style=\"flex:1\"><span style=\"display:block;font-size:var(--ds-font-body-size)\">Placeholder: merchant name</span><span style=\"display:block;font-size:var(--ds-font-caption-size);color:var(--ds-color-text-muted)\">[DATE] &middot; [CATEGORY]</span></span><span style=\"font-family:var(--ds-font-mono-family);font-size:var(--ds-font-mono-size)\">[AMOUNT]</span></li>\n      <li class=\"sp-row sp-row--compact\" style=\"padding:var(--ds-space-md) 0;border-bottom:1px solid var(--ds-color-border)\"><span aria-hidden=\"true\" style=\"width:40px;height:40px;border-radius:var(--ds-radius-full);background:var(--ds-color-surface);border:1px solid var(--ds-color-border);display:flex;align-items:center;justify-content:center;font-size:var(--ds-font-label-size);font-weight:600;color:var(--ds-color-text-muted)\">P2</span><span style=\"flex:1\"><span style=\"display:block;font-size:var(--ds-font-body-size)\">Placeholder: merchant name</span><span style=\"display:block;font-size:var(--ds-font-caption-size);color:var(--ds-color-text-muted)\">[DATE] &middot; [CATEGORY]</span></span><span style=\"font-family:var(--ds-font-mono-family);font-size:var(--ds-font-mono-size)\">[AMOUNT]</span></li>\n      <li class=\"sp-row sp-row--compact\" style=\"padding:var(--ds-space-md) 0;border-bottom:1px solid var(--ds-color-border)\"><span aria-hidden=\"true\" style=\"width:40px;height:40px;border-radius:var(--ds-radius-full);background:var(--ds-color-surface);border:1px solid var(--ds-color-border);display:flex;align-items:center;justify-content:center;font-size:var(--ds-font-label-size);font-weight:600;color:var(--ds-color-text-muted)\">P3</span><span style=\"flex:1\"><span style=\"display:block;font-size:var(--ds-font-body-size)\">Placeholder: merchant name</span><span style=\"display:block;font-size:var(--ds-font-caption-size);color:var(--ds-color-text-muted)\">[DATE] &middot; [CATEGORY]</span></span><span style=\"font-family:var(--ds-font-mono-family);font-size:var(--ds-font-mono-size)\">[AMOUNT]</span></li>\n    </ul>\n  </section>\n\n  <section aria-label=\"Parental controls\" style=\"margin:var(--ds-space-md) var(--ds-space-lg) var(--ds-space-lg);padding:var(--ds-space-md) var(--ds-space-lg);background:var(--ds-color-surface);border:1px solid var(--ds-color-border);border-radius:var(--ds-radius-lg);display:flex;align-items:center;gap:var(--ds-space-md)\">\n    <div style=\"flex:1\">\n      <p style=\"margin:0;font-size:var(--ds-font-label-size);font-weight:500;color:var(--ds-color-text)\">Spending limits</p>\n      <p style=\"margin:2px 0 0;font-size:var(--ds-font-caption-size);color:var(--ds-color-text-muted)\">Set by parent or guardian</p>\n    </div>\n    <button style=\"min-height:44px;padding:0 var(--ds-space-lg);border:none;background:var(--ds-color-primary);color:var(--ds-color-on-primary);border-radius:var(--ds-radius-md);font-family:var(--ds-font-label-family);font-size:var(--ds-font-label-size);font-weight:500;cursor:pointer\">View</button>\n  </section>\n</main>\n</body></html>", "mode": "fixed"}, {"id": "ab_341e416199c94228", "name": "Savings goals", "width": 390.0, "height": 844.0, "background": "#FFFFFF", "nodeIds": [], "html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><title>Savings goals</title><style>\n:root{\n--tw-accent: #B45309;\n--tw-progress: 12;\n--tw-density: comfortable;\n}\nbody{margin:0;background:#F3F5F7;font-family:var(--ds-font-body-family);}\n.btn{min-height:44px;}\n.goal{transition:box-shadow .15s;}\n</style></head><body style=\"margin:0;background:var(--ds-color-background);font-family:var(--ds-font-body-family);color:var(--ds-color-text)\">\n<div style=\"width:390px;height:844px;margin:0 auto;display:flex;flex-direction:column;overflow:hidden;background:var(--ds-color-background)\">\n\n<header style=\"padding:var(--ds-space-lg) var(--ds-space-lg) var(--ds-space-md);display:flex;align-items:center;justify-content:space-between\">\n<div>\n<h1 style=\"margin:0;font-family:var(--ds-font-heading-family);font-size:var(--ds-font-title-size);font-weight:var(--ds-font-title-weight);line-height:var(--ds-font-title-line-height);color:var(--ds-color-text)\">Savings goals</h1>\n<p style=\"margin:4px 0 0;font-size:var(--ds-font-caption-size);color:var(--ds-color-text-muted)\">Save towards what matters to you</p>\n</div>\n<button class=\"btn\" aria-label=\"Parental controls\" style=\"border:1px solid var(--ds-color-border);background:var(--ds-color-surface);border-radius:var(--ds-radius-md);padding:10px 12px;font-size:var(--ds-font-label-size);font-weight:500;color:var(--ds-color-text);cursor:pointer\">Parental controls</button>\n</header>\n\n<main style=\"flex:1;overflow:auto;padding:0 var(--ds-space-lg);display:flex;flex-direction:column;gap:var(--ds-space-md)\">\n\n<section aria-label=\"Total saved\" style=\"background:var(--ds-color-primary);color:var(--ds-color-on-primary);border-radius:var(--ds-radius-lg);padding:var(--ds-space-lg)\">\n<p style=\"margin:0;font-size:var(--ds-font-label-size);opacity:.9\">Total saved</p>\n<p style=\"margin:4px 0 0;font-family:var(--ds-font-heading-family);font-size:var(--ds-font-display-size);font-weight:var(--ds-font-display-weight);line-height:var(--ds-font-display-line-height)\">[YOUR TOTAL]</p>\n<p style=\"margin:4px 0 0;font-size:var(--ds-font-caption-size);opacity:.9\">Across 3 active goals · review with a parent anytime</p>\n</section>\n\n<h2 style=\"margin:var(--ds-space-xs) 0 0;font-size:var(--ds-font-label-size);font-weight:var(--ds-font-label-weight);color:var(--ds-color-text-muted);text-transform:uppercase;letter-spacing:.04em\">Active goals</h2>\n\n<article class=\"goal\" style=\"background:var(--ds-color-surface);border:1px solid var(--ds-color-border);border-radius:var(--ds-radius-lg);padding:var(--ds-space-lg)\">\n<div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:var(-