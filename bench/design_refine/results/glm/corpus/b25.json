:var(--ds-space-sm)}}\n</style>\n</head>\n<body>\n<div style=\"display:flex;flex-direction:column;height:844px;overflow:hidden\">\n<header style=\"padding:var(--ds-space-lg) var(--ds-space-lg) var(--ds-space-md)\"><h1 style=\"margin:0;font-size:var(--ds-font-title-size);font-weight:var(--ds-font-title-weight);color:var(--ds-color-text)\">Settings</h1></header>\n<main style=\"flex:1;overflow-y:auto;padding:0 var(--ds-space-lg) var(--ds-space-lg);display:flex;flex-direction:column;gap:var(--ds-space-lg)\">\n<section>\n<h2 class=\"group-title\">Profile</h2>\n<div class=\"row\"><div class=\"icon\" aria-hidden=\"true\">AB</div><span class=\"row-label\">[YOUR NAME]</span><span class=\"row-value\">Owner</span><span class=\"chev\" aria-hidden=\"true\"></span></div>\n<div class=\"row\"><div class=\"icon\" aria-hidden=\"true\">Apt</div><span class=\"row-label\">Apartment</span><span class=\"row-value\">[YOUR UNIT]</span><span class=\"chev\" aria-hidden=\"true\"></span></div>\n</section>\n<section>\n<h2 class=\"group-title\">Home</h2>\n<div class=\"row\"><div class=\"icon\" aria-hidden=\"true\">Rm</div><span class=\"row-label\">Rooms &amp; devices</span><span class=\"chev\" aria-hidden=\"true\"></span></div>\n<div class=\"row\"><div class=\"icon\" aria-hidden=\"true\">Sc</div><span class=\"row-label\">Scenes</span><span class=\"chev\" aria-hidden=\"true\"></span></div>\n<div class=\"row\"><div class=\"icon\" aria-hidden=\"true\">En</div><span class=\"row-label\">Energy preferences</span><span class=\"chev\" aria-hidden=\"true\"></span></div>\n</section>\n<section>\n<h2 class=\"group-title\">Notifications</h2>\n<div class=\"row\"><span class=\"row-label\">Device alerts</span><span class=\"switch\" role=\"switch\" aria-checked=\"true\" aria-label=\"Device alerts\" tabindex=\"0\"></span></div>\n<div class=\"row\"><span class=\"row-label\">Energy reports</span><span class=\"switch off\" role=\"switch\" aria-checked=\"false\" aria-label=\"Energy reports\" tabindex=\"0\"></span></di