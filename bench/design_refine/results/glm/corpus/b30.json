"Donate", "width": 1100.0, "height": 900.0, "background": "#FFFFFF", "nodeIds": [], "html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><title>Donate — River Clean-Up</title><style>\n:root{--ds-color-background:#FFFFFF;--ds-color-surface:#F3F5F7;--ds-color-border:#C9D1D9;--ds-color-text:#111827;--ds-color-text-muted:#4B5563;--ds-color-primary:#0F766E;--ds-color-on-primary:#FFFFFF;--ds-color-accent:#B45309;--ds-font-body-family:Inter,Arial,sans-serif;--ds-space-sm:8px;--ds-space-md:16px;--ds-space-lg:24px;--ds-space-xl:32px;--ds-space-2xl:48px;--ds-radius-md:10px;--ds-radius-lg:16px;}\n/* @tweak accent color \"Cor de destaque\" */ --tw-accent:#B45309;\n/* @tweak scale number 0.9 1.3 0.05 \"Escala do destaque\" */ --tw-scale:1;\n/* @tweak density choice \"Densidade\" \"compact\" \"comfortable\" */ --tw-density:comfortable;\nbody{margin:0;font-family:var(--ds-font-body-family);color:var(--ds-color-text);background:var(--ds-color-background);}\n.amount{--pad:calc(var(--ds-space-md) * var(--tw-scale,1) * (var(--tw-density,comfortable) == compact ? .6 : 1));}\n.amount:hover{border-color:var(--ds-color-primary);}\n.selected .amount-badge{background:var(--tw-accent);color:#fff;}\n.cta:hover{filter:brightness(1.1);}\n@media(max-width:860px){.donate-grid{grid-template-columns:1fr;}}\n</style></head><body style=\"margin:0\">\n<header style=\"display:flex;align-items:center;justify-content:space-between;padding:var(--ds-space-lg) var(--ds-space-xl);border-bottom:1px solid var(--ds-color-border)\"><a href=\"#\" style=\"font-weight:700;font-size:20px;color:var(--ds-color-primary);text-decoration:none\">[ORG NAME]</a><nav style=\"display:flex;gap:var(--ds-space-lg)\"><a href=\"#\" style=\"color:var(--ds-color-text);text-decoration:none;font-size:14px;font-weight:500\">Home</a><a href=\"#\" style=\"color:var(--ds-color-text);text-decoration:none;font-size:14px;font-weight:500\">Our work</a></nav></header>\n<main style=\"max-width:1040px;margin:0 auto;padding:var