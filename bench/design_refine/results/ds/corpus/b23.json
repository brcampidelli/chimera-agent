 "nodeIds": [], "html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><title>Browse</title><style>\n  :root {\n    /* @tweak accent color \"Accent Color\" */ --tw-accent: #0F766E;\n    /* @tweak density choice \"Density\" \"compact\" \"comfortable\" */ --tw-density: comfortable;\n  }\n  body { margin: 0; font-family: var(--ds-font-body-family); background: var(--ds-color-background); color: var(--ds-color-text); }\n  .root { display: flex; flex-direction: column; min-height: 100vh; padding: var(--ds-space-lg); gap: var(--ds-space-lg); max-width: 1200px; margin: 0 auto; }\n  .search-bar { display: flex; gap: var(--ds-space-sm); }\n  .search-input { flex: 1; padding: var(--ds-space-md); border: 1px solid var(--ds-color-border); border-radius: var(--ds-radius-md); font-size: var(--ds-font-body-size); }\n  .search-button { padding: var(--ds-space-md) var(--ds-space-lg); background: var(--tw-accent); color: var(--ds-color-on-primary); border: none; border-radius: var(--ds-radius-md); font-size: var(--ds-font-label-size); font-weight: var(--ds-font-label-weight); cursor: pointer; }\n  .category-chips { display: flex; gap: var(--ds-space-sm); flex-wrap: wrap; }\n  .chip { padding: var(--ds-space-sm) var(--ds-space-md); border: 1px solid var(--ds-color-border); border-radius: var(--ds-radius-full); background: var(--ds-color-surface); font-size: var(--ds-font-label-size); color: var(--ds-color-text); cursor: pointer; }\n  .chip.active { background: var(--tw-accent); color: var(--ds-color-on-primary); border-color: var(--tw-accent); }\n  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: var(--ds-space-md); }\n  .card { background: var(--ds-color-surface); border: 1px solid var(--ds-color-border); border-radius: var(--ds-radius-lg); padding: var(--ds-space-md); display: flex; flex-direction: column; gap: var(--ds-space-sm); }\n  .card-image { width: 100%; aspect-ratio: 1/1; background: var(--ds-color-border); border-radius: var(--ds-radius-md); display: flex; align-items: center; justify-content: center; color: var(--ds-color-text-muted); font-size: var(--ds-font-caption-size); }\n  .card-title { font-size: var(--ds-font-body-size); font-weight: var(--ds-font-body-weight); margin: 0; }\n  .card-price { font-size: var(--ds-font-title-size); font-weight: var(--ds-font-title-weight); color: var(--tw-accent); margin: 0; }\n  .card-seller { font-size: var(--ds-font-caption-size); color: var(--ds-color-text-muted); margin: 0; }\n  @media (max-width: 600px) {\n    .root { padding: var(--ds-space-md); }\n    .grid { grid-template-columns: repeat(2, 1fr); }\n  }\n</style></head><body><main class=\"root\">\n  <h1 style=\"margin:0;font-size:var(--ds-font-heading-size);color:var(--ds-color-text)\">Browse</h1>\n  <div class=\"search-bar\" role=\"search\">\n    <label for=\"search\" style=\"position:absolute;left:-9999px\">Search</label>\n    <input id=\"search\" class=\"search-input\" type=\"search\" placeholder=\"Search cameras, lenses...\">\n    <button class=\"search-button\" type=\"button\">Search</button>\n  </div>\n  <div class=\"category-chips\" role=\"group\" aria-label=\"Categories\">\n    <button class=\"chip active\" type=\"button\">All</button>\n    <button class=\"chip\" type=\"button\">Cameras</button>\n    <button class=\"chip\" type=\"button\">Lenses</button>\n    <button class=\"chip\" type=\"button\">Accessories</button>\n  </div>\n  <div class=\"grid\">\n    <article class=\"card\">\n      <div class=\"card-image\">Placeholder: Camera image</div>\n      <h2 class=\"card-title\">Canon EOS 5D Mark III</h2>\n      <p class=\"card-price\">[YOUR PRICE]</p>\n      <p class=\"card-seller\">Seller: [Seller Name]</p>\n    </article>\n    <article class=\"card\">\n      <div class=\"card-image\">Placeholder: Lens image</div>\n      <h2 class=\"card-title\">Sony FE 24-70mm f/2.8</h2>\n      <p class=\"card-price\">[YOUR PRICE]</p>\n      <p class=\"card-seller\">Seller: [Seller Name]<