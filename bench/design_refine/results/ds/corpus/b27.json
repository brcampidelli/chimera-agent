ds-space-lg); } .article-body { font-size: var(--ds-font-body-size); line-height: var(--ds-font-body-line-height); color: var(--ds-color-text); } .article-body h2 { font-size: var(--ds-font-title-size); font-weight: var(--ds-font-title-weight); margin-top: var(--ds-space-xl); } .article-body p { margin: var(--ds-space-md) 0; } .article-body code { font-family: var(--ds-font-mono-family); font-size: var(--ds-font-mono-size); background: var(--ds-color-surface); padding: 2px 4px; border-radius: var(--ds-radius-sm); } .callout { background: var(--ds-color-surface); border-left: 4px solid var(--ds-color-primary); padding: var(--ds-space-md); border-radius: var(--ds-radius-md); margin: var(--ds-space-lg) 0; } .callout p { margin: 0; } .actions { display: flex; gap: var(--ds-space-md); margin-top: var(--ds-space-xl); } .btn { padding: var(--ds-space-sm) var(--ds-space-md); border-radius: var(--ds-radius-md); font-size: var(--ds-font-label-size); font-weight: var(--ds-font-label-weight); cursor: pointer; text-decoration: none; display: inline-block; } .btn-primary { background: var(--ds-color-primary); color: var(--ds-color-on-primary); border: none; } .btn-secondary { background: var(--ds-color-surface); color: var(--ds-color-text); border: 1px solid var(--ds-color-border); } .footer { padding: var(--ds-space-md) var(--ds-space-xl); border-top: 1px solid var(--ds-color-border); background: var(--ds-color-surface); font-size: var(--ds-font-caption-size); color: var(--ds-color-text-muted); }</style></head><body><div class=\"app\"><header class=\"header\"><div class=\"logo\">Acme Support</div><nav class=\"nav\"><a href=\"#\">Help Centre</a><a href=\"#\">Contact</a><a href=\"#\">Community</a></nav><input class=\"search\" type=\"search\" placeholder=\"Search articles\" aria-label=\"Search articles\"></header><div class=\"main\"><aside class=\"sidebar\"><h2>Categories</h2><ul><li><a href=\"#\">Getting Started</a></li><li><a href=\"#\">Accounts &amp; Billing</a></li><li><a href=\"#\">Troubleshooting</a></li><li><a href=\"#\">API Reference</a></li><li><a href=\"#\">Security</a></li></ul></aside><main class=\"content\"><nav class=\"breadcrumb\"><a href=\"#\">Help Centre</a> / <a href=\"#\">Getting Started</a> / Article</nav><h1 class=\"article-title\">How to set up your account</h1><p class=\"meta\">Last updated: [DATE] · 5 min read</p><div class=\"article-body\"><p>Welcome to Acme! This guide walks you through the initial setup of your account. Follow the steps below to get started quickly.</p><h2>Step 1: Create your account</h2><p>Visit the sign-up page and enter your email address. You will receive a verification email to confirm your address.</p><h2>Step 2: Configure your profile</h2><p>Once verified, log in and complete your profile. Add your name, company, and preferred language.</p><div class=\"callout\"><p><strong>Tip:</strong> You can change these settings later from your profile page.</p></div><h2>Step 3: Invite your team</h2><p>Go to the Team section and invite colleagues by email. They will receive an invitation to join your workspace.</p><p>For more details, see the <a href=\"#\">Team Management</a> article.</p></div><div class=\"actions\"><button class=\"btn btn-primary\">Was this helpful?</button><a class=\"btn btn-secondary\" href=\"#\">Contact Support</a></div></main></div><footer class=\"footer\">© 2025 Acme Software. All rights reserved.</footer></div></body></html>", "mode": "fixed"}, {"id": "ab_6c5f344cfdc741ce", "name": "Contact", "width": 1440.0, "height": 900.0, "background": "#FFFFFF", "nodeIds": [], "html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><title>Contact</title><style>/* @tweak accent color \"Accent color\" */ --tw-accent: #0F766E; /* @tweak scale number 0.8 1.4 0.05 \"Scale\" */ --tw-scale: 1; /* @tweak density choice \"Density\" \"compact\" \"comfortable\" */ --tw-density: comfortable;</style></head><body style=\"margin:0;font-family:var(--ds-font-body-family);background:var(--ds-color-background);color:var(--ds-color-text);\"><div style=\"display:flex;flex-direction:column;min-height:100vh;padding:var(--ds-space-2xl);box-sizing:border-box;\"><header style=\"display:flex;align-items:center;justify-content:space-between;margin-bottom:var(--ds-space-2xl);\"><div style=\"display:flex;align-items:center;gap:var(--ds-space-md);\"><div style=\"width:40px;height:40px;background:var(--ds-color-primary);border-radius:var(--ds-radius-md);\"></div><span style=\"font-size:var(--ds-font-title-size);font-weight:var(--ds-font-title-weight);color:var(--ds-color-text);\">Support Portal</span></div><nav style=\"display:flex;gap:var(--ds-space-lg);\"><a href=\"#\" style=\"color:var(--ds-color-text-muted);text-decoration:none;font-size:var(--ds-font-label-size);\">Help centre</a><a href=\"#\" style=\"color:var(--ds-color-text-muted);text-decoration:none;font-size:var(--ds-font-label-size);\">Article</a><a href=\"#\" style=\"color:var(--ds-color-primary);text-decoration:none;font-size:var(--ds-font-label-size);font-weight:var(--ds-font-label-weight);\">Contact</a></nav></header><main style=\"display:flex;flex-direction:column;gap:var(--ds-space-2xl);max-width:1200px;width:100%;margin:0 auto;\"><section style=\"display:flex;flex-direction:column;gap:var(--ds-space-md);\"><h1 style=\"margin:0;font-size:var(--ds-font-heading-size);font-weight:var(--ds-font-heading-weight);color:var(--ds-color-text);\">Contact us</h1><p style=\"margin:0;font-size:var(--ds-font-body-size);color:var(--ds-color-text-muted);\">We're here to help. Fill out the form and we'll get back to you within 24 hours.</p></section><div style=\"display:grid;grid-template-columns:1fr 1fr;gap:var(--ds-space-2xl);align-items:start;\"><section style=\"background:var(--ds-color-surface);border:1px solid var(--ds-color-border);border-radius:var(--ds-radius-lg);padding:var(--ds-space-lg);\"><h2 style=\"margin:0 0 var(--ds-space-md);font-size:var(--ds-font-title-size);font-weight:var(--ds-font-title-weight);co