# .rgignore: keeps ripgrep (and anything built on it) away from data and
# generated files, so a search for a symbol lands on source, not on a 9 MB
# jsonl. Closed list on purpose: a wide pattern hides a file nobody can find
# and nothing errors. Never ignore PREREGISTRATION*.md, RESULT*.md, bench
# scripts, tests/ or apps/desktop/src/lib/i18n.tsx (that one is source).
# `git` is unaffected; this file is read by ripgrep only.

# --- bench output: raw run data written by the bench scripts -----------
# Only the data extensions inside results*/ and _archive*/ are listed, not
# the directories, so the .md reports (RESULTS*, PREREGISTRATION*) that
# live beside them stay searchable.
bench/**/results*/**/*.jsonl
!bench/**/results*/**/items*.jsonl
!bench/**/results*/**/corpus*.jsonl
!bench/**/results*/**/heldout*.jsonl
bench/**/results*/**/*.json
bench/**/results*/**/*.log
bench/**/results*/**/*.txt
bench/**/results*/**/*.csv
bench/**/results*/**/*.diff
bench/**/results*/**/*.sh
bench/**/_archive*/**/*.jsonl
bench/**/_archive*/**/*.json
bench/**/_archive*/**/*.log
bench/**/_archive*/**/*.txt
bench/**/_archive*/**/*.csv
bench/**/_archive*/**/*.diff
# Loose outputs written next to a bench script, listed by name. NOT a blanket
# bench/**/*.jsonl: corpus.jsonl, items.jsonl, heldout.jsonl and requests.jsonl
# are frozen, pre-registered INPUTS and must stay searchable.
# results.jsonl / results-<date>.jsonl: row dumps written by the bench runner
bench/**/results.jsonl
bench/**/results-*.jsonl
# journal.jsonl: per-run journal written by bench/local_lift/_reverify_*
bench/**/journal.jsonl
# run logs: stdout captured by the bench runners
bench/**/*.log
# the committed raw-stdout logs at the top of the repo
/*.log

# --- generated from source, regenerate instead of reading --------------
# python -m chimera.api.schema_dump > apps/desktop/openapi.json
apps/desktop/openapi.json
# npm --prefix apps/desktop run gen:api (from openapi.json)
apps/desktop/src/lib/api-schema.ts
# chimera/cli snapshot regenerated by the command-reference test
chimera/_cli_snapshot.json
# lockfiles: uv lock / npm install
uv.lock
package-lock.json
