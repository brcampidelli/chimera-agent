# Normalize line endings to LF in the repository (Python project, cross-platform).
* text=auto eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
*.gz binary
*.wav binary
*.mp3 binary
*.mp4 binary
*.db binary
*.sqlite binary
