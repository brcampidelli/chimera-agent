{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "chimera-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "chimera", "app", "--port", "8765"],
      "port": 8765
    },
    {
      "name": "desktop-ui",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/desktop", "run", "dev"],
      "port": 5173
    },
    {
      "name": "site",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "../chimera-site", "run", "dev"],
      "port": 3000
    }
  ]
}
