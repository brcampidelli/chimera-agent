{
  "manifest_version": 3,
  "name": "Chimera Browser",
  "version": "0.1.0",
  "description": "Connect Chimera to a permissioned Chrome tab group.",
  "minimum_chrome_version": "102",
  "permissions": ["debugger", "nativeMessaging", "storage", "tabGroups", "tabs", "activeTab"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "service_worker.js" },
  "action": { "default_title": "Connect Chimera" }
}
